# Copy to .env.local to preset the AI provider when running on your own machine.
# Providers: demo | anthropic | openai | gemini | ollama | lmstudio | custom
VITE_LLM_PROVIDER=ollama
VITE_LLM_BASE_URL=http://localhost:11434/v1
VITE_LLM_MODEL=llama3.1
# Only for local use. Never set a key in a build you deploy publicly: it is bundled into the JS.
VITE_LLM_API_KEY=
